"""Bazel build for Apache Arrow C++ core and IPC.

The explicit source groups below mirror cpp/src/arrow/CMakeLists.txt in Arrow
25.0.0. Keep them explicit: a recursive source glob would accidentally compile
tests, fuzzers, binaries, optional components, and ISA-specific translation
units without their required flags.

Enabled components: core, IPC/Feather, CSV, JSON, local/HDFS filesystems,
all BCR-backed compression codecs and allocators, full Compute, Acero, Dataset,
Parquet, Flight, and Flight SQL. See the README for intentionally omitted parts.
"""

load("@flatbuffers//:build_defs.bzl", "flatbuffer_cc_library")
load("@grpc//bazel:generate_cc.bzl", "generate_cc")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # Apache-2.0

exports_files([
    "LICENSE.txt",
    "NOTICE.txt",
])

proto_library(
    name = "flight_proto",
    srcs = ["format/Flight.proto"],
    deps = ["@protobuf//:timestamp_proto"],
)

cc_proto_library(
    name = "flight_cc_proto",
    deps = [":flight_proto"],
)

genrule(
    name = "arrow_util_config",
    srcs = ["cpp/src/arrow/util/config.h.cmake"],
    outs = ["cpp/src/arrow/util/config.h"],
    cmd = ("sed " +
           "-e 's/@ARROW_VERSION_MAJOR@/25/g' " +
           "-e 's/@ARROW_VERSION_MINOR@/0/g' " +
           "-e 's/@ARROW_VERSION_PATCH@/1/g' " +
           "-e 's/cmakedefine ARROW_USE_NATIVE_INT128/undef ARROW_USE_NATIVE_INT128/g' " +
           "-e 's/cmakedefine/define/g' " +
           "$< >$@"),
)

genrule(
    name = "arrow_util_config_internal",
    srcs = ["cpp/src/arrow/util/config_internal.h.cmake"],
    outs = ["cpp/src/arrow/util/config_internal.h"],
    cmd = "cp $< $@",
)

genrule(
    name = "parquet_version_h",
    srcs = ["cpp/src/parquet/parquet_version.h.in"],
    outs = ["cpp/src/parquet/parquet_version.h"],
    cmd = ("sed " +
           "-e 's/@PARQUET_VERSION_MAJOR@/25/g' " +
           "-e 's/@PARQUET_VERSION_MINOR@/0/g' " +
           "-e 's/@PARQUET_VERSION_PATCH@/0/g' " +
           "$< >$@"),
)

# Arrow includes these generated .cc files after defining serialization and
# export customizations, so keep the codegen outputs textual instead of using a
# normally compiled cc_grpc_library.
generate_cc(
    name = "flight_grpc_codegen",
    srcs = [":flight_proto"],
    plugin = "@grpc//src/compiler:grpc_cpp_plugin",
    well_known_protos = False,
)

proto_library(
    name = "flight_sql_proto",
    srcs = ["format/FlightSql.proto"],
    deps = ["@protobuf//:descriptor_proto"],
)

generate_cc(
    name = "flight_sql_codegen",
    srcs = [":flight_sql_proto"],
    flags = ["dllexport_decl=ARROW_FLIGHT_SQL_EXPORT"],
    well_known_protos = False,
)

flatbuffer_cc_library(
    name = "arrow_flatbuffers",
    srcs = [
        "cpp/src/arrow/ipc/feather.fbs",
        "format/File.fbs",
        "format/Message.fbs",
        "format/Schema.fbs",
        "format/SparseTensor.fbs",
        "format/Tensor.fbs",
    ],
    cc_include_paths = [
        "cpp/src",
        "cpp/src/generated",
    ],
    flatc_args = [
        "--cpp-std",
        "c++11",
    ],
    include_paths = [
        "cpp/src/arrow/ipc",
        "format",
    ],
    out_prefix = "cpp/src/generated/",
    visibility = ["//visibility:private"],
)

genrule(
    name = "flight_pb",
    outs = ["cpp/src/arrow/flight/Flight.pb.h"],
    cmd = """echo '#include "arrow/format/Flight.pb.h"' > $@""",
)

genrule(
    name = "flight_grpc_h",
    outs = ["cpp/src/arrow/flight/Flight.grpc.pb.h"],
    cmd = """echo '#include "arrow/format/Flight.grpc.pb.h"' > $@""",
)

genrule(
    name = "flight_grpc_cc",
    outs = ["cpp/src/arrow/flight/Flight.grpc.pb.cc"],
    cmd = """echo '#include "arrow/format/Flight.grpc.pb.cc"' > $@""",
)

genrule(
    name = "flight_sql_cc",
    outs = ["cpp/src/arrow/flight/sql/FlightSql.pb.cc"],
    cmd = """echo '#include "arrow/format/FlightSql.pb.cc"' > $@""",
)

genrule(
    name = "flight_sql_h",
    outs = ["cpp/src/arrow/flight/sql/FlightSql.pb.h"],
    cmd = """echo '#include "arrow/format/FlightSql.pb.h"' > $@""",
)

